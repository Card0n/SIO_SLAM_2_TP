{% extends 'base.html.twig' %}



{% block title %}Hello ClientController!{% endblock %}



{% block body %}




<div class="example-wrapper">

<h1>Liste des Clients</h1>
<br>

<button><a href="{{ path('app_clients_ajouter') }}">Ajouter un client</a></button>

    {% if clients|length > 0 %}

<table>
    <tr>
        <th>Client</th>
        <th>Téléphone</th>
        <th>Mail</th>
        <th>Adresse</th>
        <th>Code postal</th>
        <th>Actions</th>
    </tr>
<tr>

            {% for client in clients %}
    <td>
        <strong>{{ client.prenom }} {{ client.nom }}</strong>
    </td>
    <td>
        {% if client.telephone %}
            {{ client.telephone }}
        {% endif %}
    </td>
    <td>
        {% if client.mail %}
            {{ client.mail }}
        {% endif %}
    </td>
    <td>
        {% if client.adresse %}
            {{ client.adresse }}
        {% endif %}
    </td>
    <td>
        {% if client.codePostal %}
            {{ client.codePostal }}
        {% endif %}
    </td>
    <td>
        <a href="{{ path('app_clients_modifier') }}">Modifier</a>
        <a href="{{ path('app_clients_supprimer') }}">Supprimer</a>
    </td>
</tr>
                {% endfor %}
</tr>
    {% else %}
<p>Aucun client trouvé.</p>
    {% endif %}



</div>
{% endblock %}





